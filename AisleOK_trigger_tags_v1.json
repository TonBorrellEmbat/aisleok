    "calls": "1 live call per real user scan",
    "attribution": "Attribute Open Food Facts and link the OFF product page on the result",
    "cache": "Do not cache a substantial OFF extract (ODbL share-alike). Tag list stays our IP, separate.",
    "looks_wrong": "Verdict control 'This looks wrong' treats the OFF list as no ingredients \u2192 Unknown + Photo of label. Do not silently rescore a bad list. Example: Chobani Vanilla 0037600115445 returned pork/ham.",
    "flow": "scan \u2192 OFF v3 \u2192 score locked 101 tags \u2192 else Unknown + photo",
    "looks_wrong_ui": {
      "placement": "same verdict screen, under dose line or under ingredient chip if no dose",
      "style": "text link only, regular weight, sand, no icon, no confirm",
      "visible_on": [
        "eat",
        "small",
        "skip"
      ],
      "hidden_on": [
        "unknown"
      ],
      "tap": "drop OFF ingredients, keep product name, switch to Unknown + 'We don\u2019t know this one', primary button Photo of label",
