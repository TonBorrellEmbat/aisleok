  "scoring": {
    "normalize": "lowercase; strip punctuation except hyphens; collapse whitespace; longest alias first",
    "top": "first 5 ingredients on a packaged label",
    "late": "position > 5",
    "priority": "skip > small > eat; tie = earliest in the list",
    "named_ingredient": "display_name of the winning tag",
    "produce": "typed name uses default_band; ignore if_late",
    "unknown": "no ingredients parsed, or zero trusted matches",
    "plural": "after longest-alias match, also accept simple English plural/singular of each alias",
    "corn_starch": "do not match alias 'corn' inside 'corn starch' or 'corn syrup' \u2014 require whole-token equality after split, except multi-word aliases",
    "whole_token": "After comma-split, the entire ingredient token must equal an alias (or its simple plural/singular). Do not match an alias as a word inside a longer token. Confirmed miss: soybeans/soybean must not match 'soybean oil' (mayo, Jif). Same class, later: almond must not match almond milk. Already: corn must not match corn starch or corn syrup.",
    "ocr": "v1 required, not a fallback. Unknown in-aisle = SKU not in OFF AND OCR fail, not a thin dictionary.",
    "usda": "No USDA in v1. No data.gov key in the app.",
    "backend": "No backend in v1.",
    "head_noun": "A token also matches if its last word equals an alias (or simple plural), EXCEPT lactose-family tags, which are exact-token only: milk, cream, whey, yogurt, lactose, buttermilk, ice cream, soft cheese. So 'almond milk' and 'oat milk' do not become milk \u2192 skip. 'whole grain oats' \u2192 oats and 'roasted peanuts' \u2192 peanuts still work. 'soybean oil' / 'peanut oil' last word is oil, unmatched. Mayo stays eat.",
